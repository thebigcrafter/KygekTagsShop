{
    "name": "thebigcrafter/kygektagsshop",
    "description": "A PocketMine-MP plugin that allows players to use tags",
    "type": "pocketmine-plugin",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/axolotl-pm/PocketMine-MP",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/Vecnavium/FormsUI"
        },
        {
            "type": "vcs",
            "url": "https://github.com/thebigcrafter/Hydrogen"
        }
    ],
    "require": {
        "vecnavium/formsui": "dev-master",
        "thebigcrafter/hydrogen": "^1.1.4",
        "sof3/libasynql": "^4.1.7"
    },
    "require-dev": {
        "sof3/pharynx": "^0.2",
        "friendsofphp/php-cs-fixer": "^3.17",
        "phpstan/phpstan": "^2.1",
        "axolotl-pm/pocketmine-mp": "5.49.1"
    },
    "license": "GPL-3.0-or-later",
    "autoload": {
        "psr-4": {
            "Kygekraqmak\\KygekTagsShop\\": "src/Kygekraqmak/KygekTagsShop/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse -c phpstan.neon.dist"
    }
}
